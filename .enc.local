# Copy this file to .env.local and fill in your own values

# From your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key - NEVER expose this to the browser, only used in API routes
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Basic auth for the /dashboard route (this is NOT a real login system,
# just a lock on the door so the public can't casually browse the dashboard)
DASHBOARD_USER=authority
DASHBOARD_PASS=demo123
